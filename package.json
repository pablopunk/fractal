{
  "name": "fractal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "astro dev --port 7666 --host 127.0.0.1",
    "build": "astro build",
    "start": "HOST=127.0.0.1 PORT=7666 node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "pnpm rebuild",
    "electron": "pnpm exec electron .",
    "electron:dev": "concurrently -k \"pnpm dev\" \"pnpm exec wait-on tcp:127.0.0.1:7666 && ELECTRON_RENDERER_URL=http://127.0.0.1:7666 pnpm exec electron .\"",
    "electron:dev:build": "pnpm rebuild:electron && astro build && pnpm exec electron .",
    "dist": "pnpm rebuild:electron && astro build && electron-builder --publish never",
    "dist:mac": "pnpm rebuild:electron && astro build && electron-builder --mac --publish never",
    "dist:win": "pnpm rebuild:electron && astro build && electron-builder --win --publish never",
    "dist:linux": "pnpm rebuild:electron && astro build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.6",
    "@astrojs/react": "^5.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "astro": "^6.2.2",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "fuzzysort": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "electron",
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "dev.fractal.app",
    "productName": "Fractal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/*.map",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development"
    }
  }
}
