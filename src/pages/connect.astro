<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fractal — Connect</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0a0a;
      color: #e0e0e0;
      font-family: system-ui, sans-serif;
    }
    .connect-box {
      text-align: center;
      padding: 2rem;
    }
    .connect-spinner {
      width: 32px;
      height: 32px;
      border: 3px solid #333;
      border-top-color: #7c7cff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 1rem;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    h1 { font-size: 1.25rem; font-weight: 500; margin: 0; }
    p { color: #888; font-size: 0.85rem; margin-top: 0.5rem; }
  </style>
</head>
<body>
  <div class="connect-box">
    <div class="connect-spinner"></div>
    <h1>Connecting to Fractal</h1>
    <p id="status">Storing access token…</p>
  </div>
  <script>
    (function () {
      const token = new URLSearchParams(window.location.search).get("token")
        || new URLSearchParams(window.location.hash.slice(1)).get("token");
      const status = document.getElementById("status");
      if (!status) return;

      if (token) {
        try {
          localStorage.setItem("fractal:remoteToken", token);
          status.textContent = "Connected. Redirecting…";
        } catch (e) {
          status.textContent = "Could not store token. Check browser storage.";
          return;
        }
      } else {
        status.textContent = "No token found in URL. Redirecting anyway…";
      }

      setTimeout(function () {
        window.location.replace("/");
      }, 600);
    })();
  </script>
</body>
</html>
